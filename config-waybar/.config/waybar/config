{
  "layer": "top",
  "position": "top",
  "height": 51,
  "margin-top": 4,
  "margin-left": 7,
  "margin-bottom": 0,
  "margin-right": 12,
  "spacing": 10,
  "modules-left": [
    "custom/launcher",
    "clock",
    "custom/media"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "battery",
    "bluetooth",
    "network",
    "custom/recording",
    "custom/gamemode",
    "custom/power-menu"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 4
    }
  },
  "clock": {
    "format": "<b>{:%H:%M:%S}</b>",
    "format-alt": "<b>{:%A, %d %B %Y}</b>",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 1
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} <b>{percent}%</b>",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "tooltip": false,
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "network": {
    "format-wifi": "<b>󰤨 {essid}</b>",
    "format-ethernet": "<b>󰈀 Connected</b>",
    "format-disconnected": "<b>󰤭</b>",
    "tooltip": true,
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n󰓅 {ipaddr}/{cidr}",
    "on-click": "~/.config/rice/bin/rice-hub net",
    "interval": 5
  },
  "bluetooth": {
    "format": "<b>󰂯</b>",
    "format-connected": "<b>󰂱 {num_connections}</b>",
    "format-disabled": "<b>󰂲</b>",
    "on-click": "~/.config/rice/bin/rice-hub bt",
    "interval": 30
  },
  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<b>{icon} {capacity}%</b>",
    "format-charging": "<b>󰂄 {capacity}%</b>",
    "format-plugged": "<b>󰚥 {capacity}%</b>",
    "format-full": "<b>󰁹 Full</b>",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": true
  },
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "~/.config/rice/bin/rice-hub"
  },
  "custom/power-menu": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout -b 5 -T 400 -B 400"
  },
  "custom/recording": {
    "exec": "~/.config/rice/bin/rice-record status",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/rice/bin/rice-record stop",
    "tooltip": true
  },
  "custom/gamemode": {
    "exec": "~/.config/rice/bin/rice-gamemode status",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "~/.config/rice/bin/rice-gamemode toggle",
    "tooltip": true
  },
  "custom/media": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/mediaplayer.sh",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "escape": true
  }
}
