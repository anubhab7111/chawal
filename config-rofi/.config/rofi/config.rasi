/* rofi: app launcher (SUPER+Space) and the dmenu-style menus in
   ~/.config/rice/bin. Colours come from the active theme through the
   themes/colors.rasi slot that rice-theme creates. */
configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "candy-icons";
    drun-display-format: "{name}\n<span size='small' alpha='60%'>{comment}</span>";
    display-drun: "󰀻  Apps";
    display-run: "  Run";
    display-dmenu: "";
    font: "JetBrainsMono Nerd Font 12";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    kb-cancel: "Escape,Control+g";
    /* Tab flips between modes (the hub tabs); element-next/prev gave Tab away */
    kb-element-next: "";
    kb-element-prev: "";
    kb-mode-next: "Tab,Control+Tab";
    kb-mode-previous: "ISO_Left_Tab,Control+ISO_Left_Tab";
}

@theme "~/.config/rofi/themes/rice.rasi"
