/* Rice look for every rofi window: translucent glass panel (about 75% opaque,
   blurred by Hyprland), the Hyprland tri-colour ring, search first, underline
   tabs, and each row a card with a round icon badge like the quick-settings
   tiles; the selected row is the gradient pill.
   colors.rasi is a slot (rice-theme) -> the active theme's rofi-colors.rasi,
   which defines glass, card, badge, fg, fg-dim, accent, urgent, line, tint and
   the gradients. App rows are two lines (name, then description: config.rasi);
   scripts that print plain rows hide the badge with element-icon { size: 0 }. */
@import "~/.config/rofi/themes/colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    spacing: 0;
}

window {
    width: 900px;
    location: center;
    anchor: center;
    padding: 1px;
    border-radius: 18px;
    background-image: @grad-border;
}

mainbox {
    children: [ inputbar, mode-switcher, message, listview ];
    spacing: 12px;
    padding: 16px;
    border-radius: 17px;
    background-color: @glass;
}

inputbar {
    children: [ textbox-search, entry ];
    spacing: 12px;
    padding: 12px 18px;
    border-radius: 14px;
    background-color: @card;
}

textbox-search {
    expand: false;
    str: "󰍉";
    text-color: @underline;
}

entry {
    placeholder: "Type to search…";
    placeholder-color: @fg-dim;
    cursor: text;
}

prompt {
    enabled: false;
}

mode-switcher {
    spacing: 18px;
    padding: 0px 6px;
}

button {
    padding: 4px 2px 6px 2px;
    background-color: transparent;
    text-color: @fg-dim;
    horizontal-align: 0.5;
    border: 0px 0px 2px 0px;
    border-color: transparent;
    cursor: pointer;
}

button selected {
    text-color: @fg;
    border-color: @underline;
}

button.selected,
button selected.normal {
    text-color: @fg;
    border-color: @underline;
}

message {
    padding: 8px 14px;
    border-radius: 12px;
    background-color: @card;
}

textbox {
    font: "JetBrainsMono Nerd Font 10";
    text-color: @fg-dim;
    markup: true;
}

listview {
    lines: 6;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 8px 12px 8px 8px;
    spacing: 14px;
    border-radius: 14px;
    background-color: @card;
    cursor: pointer;
}

element normal.active,
element alternate.active {
    background-color: @tint;
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element selected.normal {
    background-image: @grad-sel;
    text-color: @ink;
}

element selected.active {
    background-image: @grad-sel;
    text-color: @ink;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @ink;
}

element-icon {
    size: 30px;
    padding: 8px;
    border-radius: 14px;
    background-color: @badge;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    markup: true;
}
