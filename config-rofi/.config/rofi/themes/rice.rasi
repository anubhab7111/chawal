/* Rice look for every rofi window: the Waybar glass -- translucent dark
   panel, hairline border, 14px corners, one cyan accent, pill rows.
   colors.rasi is a slot (rice-theme) -> the active theme's rofi-colors.rasi,
   which defines bg, bg-alt, surface, fg, fg-dim, accent, urgent, line, tint. */
@import "~/.config/rofi/themes/colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    spacing: 0;
}

window {
    width: 640px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: @line;
    border-radius: 14px;
    background-color: @bg;
    padding: 14px;
}

mainbox {
    children: [ mode-switcher, inputbar, message, listview ];
    spacing: 12px;
}

/* Tab strip: one pill per mode, the active one in cyan */
mode-switcher {
    spacing: 6px;
}

button {
    padding: 6px 14px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @fg-dim;
    horizontal-align: 0.5;
    cursor: pointer;
}

button selected {
    background-color: @tint;
    text-color: @accent;
}

button.selected,
button selected.normal {
    background-color: @tint;
    text-color: @accent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
}

/* The tab strip already names the mode, so the prompt stays out of the way */
prompt {
    enabled: false;
}

entry {
    placeholder: "  Search";
    placeholder-color: @fg-dim;
    cursor: text;
}

/* Footer-style hint / status line (script modes fill it) */
message {
    padding: 8px 14px;
    border-radius: 10px;
    background-color: @bg-alt;
}

textbox {
    text-color: @fg-dim;
    markup: true;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element normal.active,
element alternate.active {
    background-color: @tint;
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element selected.normal {
    background-color: @surface;
    text-color: @accent;
}

element selected.active {
    background-color: @tint;
    text-color: @accent;
    border: 1px;
    border-color: @accent;
}

element selected.urgent {
    background-color: @surface;
    text-color: @urgent;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
