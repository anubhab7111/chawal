;; Quick-settings panel: a card in the top-right corner with a grid of toggle
;; tiles (Wi-Fi, Bluetooth, DND, night light, caffeine, game mode, power
;; profile, theme), volume / mic / brightness sliders and a media card. The
;; network lists come later (P31).
;;
;; Two windows, both created only while the panel is open (scripts/qs-ctl):
;;   qs-scrim   transparent, covers the screen under the panel; a click on it
;;              closes the panel. Opened first so the panel sits above it.
;;   qs-panel   the card itself.
;; Esc closes it too: qs-ctl asks Hyprland (rice.qs.escape_on in modules/qs.lua)
;; for an Escape bind that exists only while the panel is open.
;;
;; No revealer inside the panel (a window sized while its revealer is collapsed
;; stays 1 px tall): the window always has its content size, and the
;; compositor's layer animation (rules.lua) slides it in.
;;
;; The tile states come from `rice-toggle rows`, polled every 2 s while the
;; panel is open (:run-while), pre-filled by qs-ctl on open and refreshed at
;; once after a click (qs-flip). The slider levels (qs-levels) and the media
;; card (qs-media) are polled every 1 s the same way; mute icons and media
;; buttons refresh their data at once. Nothing runs while the panel is closed.
;;
;; eww gives every window a CSS class equal to its name ("qs-scrim",
;; "qs-panel"); the widget classes are qs-dim / qs-card / qs-tile... so that
;; no card rule paints the window itself (see eww.css).

(defvar qs_open false)

(defpoll qs_rows :interval "2s"
                 :initial "[]"
                 :run-while qs_open
  "scripts/qs-rows")

(defpoll qs_levels :interval "1s"
                   :initial "{\"vol\":0,\"muted\":false,\"mic\":0,\"micmuted\":false,\"bri\":0}"
                   :run-while qs_open
  "scripts/qs-levels")

(defpoll qs_media :interval "1s"
                  :initial "{\"on\":false,\"status\":\"\",\"title\":\"\",\"artist\":\"\",\"art\":\"\"}"
                  :run-while qs_open
  "scripts/qs-media")

(defwindow qs-scrim
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "qs-scrim"
  :geometry (geometry :anchor "top left" :width "100%" :height "100%")
  (eventbox :onclick "scripts/qs-ctl close"
            :onrightclick "scripts/qs-ctl close"
            :onmiddleclick "scripts/qs-ctl close"
    (box :class "qs-dim")))

(defwindow qs-panel
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "qs-panel"
  :geometry (geometry :anchor "top right" :x "8px" :y "8px" :width "360px")
  (qs-card))

(defwidget qs-card []
  (box :class "qs-card" :orientation "v" :space-evenly false
    (label :class "qs-title" :halign "start" :text "Quick settings")
    ;; The tiles get their own box: eww appends `for` children after the static
    ;; siblings of the box they sit in, which put the rows below the sliders.
    (box :class "qs-tiles" :orientation "v" :space-evenly false
      (for row in qs_rows
        (box :class "qs-row" :orientation "h" :space-evenly true
          (for tile in row
            (qs-tile :t tile)))))
    (box :class "qs-sliders" :orientation "v" :space-evenly false
      (qs-slider :kind "vol" :value {qs_levels.vol} :off {qs_levels.muted}
                 :icon {qs_levels.muted ? "󰖁" : (qs_levels.vol > 66 ? "󰕾" : (qs_levels.vol > 0 ? "󰖀" : "󰕿"))}
                 :mute "scripts/qs-set vol-mute")
      (qs-slider :kind "mic" :value {qs_levels.mic} :off {qs_levels.micmuted}
                 :icon {qs_levels.micmuted ? "󰍭" : "󰍬"}
                 :mute "scripts/qs-set mic-mute")
      (qs-slider :kind "bri" :value {qs_levels.bri} :off false
                 :icon {qs_levels.bri > 66 ? "󰃠" : (qs_levels.bri > 33 ? "󰃟" : "󰃞")}
                 :mute ""))
    (qs-media)))

;; A slider row: icon (click mutes; volume and mic only), the scale, the value.
(defwidget qs-slider [kind value off icon mute]
  (box :class "qs-slider-row" :orientation "h" :space-evenly false
    (eventbox :cursor {mute != "" ? "pointer" : "default"} :onclick mute
      (label :class "qs-slider-icon${off ? ' off' : ''}" :text icon))
    (scale :class "qs-slider${off ? ' off' : ''}"
           :hexpand true
           :orientation "h"
           :min 0
           :max 100
           :value value
           :onchange "scripts/qs-set ${kind} {}")
    (label :class "qs-slider-pct" :text "${value}%")))

;; The media card: cover (or a note glyph), title and artist, three buttons.
;; Hidden while no player runs.
(defwidget qs-media []
  (box :visible {qs_media.on}
    (box :class "qs-media" :orientation "h" :space-evenly false
      (box :class "qs-cover"
           :style {qs_media.art != "" ? "background-image: url('${qs_media.art}');" : ""}
        (label :class "qs-cover-glyph" :text {qs_media.art != "" ? "" : "󰎆"}))
      (box :class "qs-media-text" :orientation "v" :valign "center" :hexpand true :space-evenly false
        (label :class "qs-media-title" :halign "start" :limit-width 22 :text {qs_media.title})
        (label :class "qs-media-artist" :halign "start" :limit-width 22 :text {qs_media.artist})
        (box :class "qs-media-btns" :orientation "h" :halign "start" :space-evenly false
          (eventbox :cursor "pointer" :onclick "scripts/qs-media-ctl prev"
            (label :class "qs-media-btn" :text "󰒮"))
          (eventbox :cursor "pointer" :onclick "scripts/qs-media-ctl toggle"
            (label :class "qs-media-btn play" :text {qs_media.status == "Playing" ? "󰏤" : "󰐊"}))
          (eventbox :cursor "pointer" :onclick "scripts/qs-media-ctl next"
            (label :class "qs-media-btn" :text "󰒭")))))))

(defwidget qs-tile [t]
  (eventbox :cursor {t.enabled ? "pointer" : "default"}
            :onclick {t.enabled ? "scripts/qs-flip ${t.id}" : ""}
    (box :class "qs-tile ${t.on ? 'on' : 'off'}${t.enabled ? '' : ' disabled'}"
         :orientation "h"
         :space-evenly false
      (label :class "qs-tile-icon" :text {t.icon})
      (box :class "qs-tile-text" :orientation "v" :valign "center" :halign "start"
           :hexpand true :space-evenly false
        (label :class "qs-tile-name" :halign "start" :limit-width 14 :text {t.label})
        (label :class "qs-tile-sub" :halign "start" :limit-width 14 :text {t.sub})))))
