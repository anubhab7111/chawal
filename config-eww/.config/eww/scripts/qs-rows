#!/usr/bin/env bash
# The tile states for the quick-settings panel, as JSON rows (see rice-toggle),
# with the clicks that have not landed yet laid over the real state.
#
# A click flips its tile on screen at once (qs-opt) and records the state it
# asked for in $RUN/pend/ID, because the change itself takes a moment. Until
# the real state agrees, or the entry runs out (a change that never happens
# shows its real state again), the tile keeps the clicked state. That also
# stops a poll that began before a click from flipping the tile back for an
# instant. What is returned is also kept in $RUN/rows.json: it is what is on
# screen, and qs-opt flips the next click from it.

set -u

BIN="${RICE_BIN:-$HOME/.config/rice/bin}"
RUN="${QS_RUN:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rice/qs}" # QS_RUN: tests
mkdir -p "$RUN/pend"

real=$("$BIN/rice-toggle" rows) || exit 1
[ -n "$real" ] || exit 1

out=$real
shopt -s nullglob
files=("$RUN"/pend/*)
if ((${#files[@]})); then # (nothing pending is the usual case: no extra work then)
    # the pending clicks as one JSON object keyed by tile id; read after the real
    # state, so a click that came in meanwhile is seen. A half-written entry is skipped.
    pend=$(for f in "${files[@]}"; do
        printf '{"%s":%s}\n' "${f##*/}" "$(cat "$f" 2>/dev/null)"
    done | jq -s -c 'add // {}' 2>/dev/null)
    [ -n "$pend" ] || pend='{}'

    now=$(date +%s%3N)
    # line 1: the rows to show; the lines after it: pending entries that are over
    # (the real state agrees, or they ran out)
    res=$(jq -r --argjson pend "$pend" --argjson now "$now" '
        [ .[] | [ .[] | . as $t | ($pend[$t.id]) as $p
            | (if $p == null or ($t.enabled | not) then {t: $t, drop: false}
               elif ($p.exp <= $now) or ($p.on == $t.on and ($t.id != "power" or $p.sub == $t.sub))
               then {t: $t, drop: true}
               else {t: ($t + {on: $p.on, sub: $p.sub}), drop: false} end)
            + {id: $t.id} ] ]
        | (map(map(.t)) | tojson), (.[][] | select(.drop) | .id)' <<<"$real") || exit 1

    {
        IFS= read -r out
        while IFS= read -r id; do rm -f "$RUN/pend/$id"; done
    } <<<"$res"
    [ -n "$out" ] || exit 1
fi

printf '%s\n' "$out" >"$RUN/rows.json.$$" && mv -f "$RUN/rows.json.$$" "$RUN/rows.json"
printf '%s\n' "$out"
