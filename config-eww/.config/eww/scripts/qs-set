#!/usr/bin/env bash
# qs-set KIND VALUE: a quick-settings slider moved, or a mute icon was clicked.
#
#   qs-set vol N        volume N% (unmutes: dragging is an explicit "I want sound")
#   qs-set mic N        microphone N%
#   qs-set bri N        brightness N% (never below 1%)
#   qs-set vol-mute     toggle output mute
#   qs-set mic-mute     toggle microphone mute
#
# WPCTL / BRIGHTNESSCTL / QS_NOREFRESH: tests.
WPCTL="${WPCTL:-wpctl}"
BRIGHTNESSCTL="${BRIGHTNESSCTL:-brightnessctl}"
CFG=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

pct() { printf '%.0f' "${1:-0}"; }

case ${1:-} in
vol)
    "$WPCTL" set-mute @DEFAULT_AUDIO_SINK@ 0
    "$WPCTL" set-volume @DEFAULT_AUDIO_SINK@ "$(pct "${2:-}")%"
    ;;
mic)
    "$WPCTL" set-volume @DEFAULT_AUDIO_SOURCE@ "$(pct "${2:-}")%"
    ;;
bri)
    v=$(pct "${2:-}")
    ((v < 1)) && v=1
    "$BRIGHTNESSCTL" set "${v}%" >/dev/null
    ;;
vol-mute) "$WPCTL" set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
mic-mute) "$WPCTL" set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
*)
    sed -n '3,10s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac

# A drag gets its value back from the poll; a click on a mute icon should show at once.
case $1 in
*-mute) [ -n "${QS_NOREFRESH:-}" ] || eww --config "$CFG" update "qs_levels=$("$CFG/scripts/qs-levels")" >/dev/null 2>&1 ;;
esac
