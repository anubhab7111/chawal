#!/usr/bin/env bash
# qs-media-ctl prev|toggle|next: a media-card button was clicked.
# PLAYERCTL / QS_NOREFRESH: tests.
PLAYERCTL="${PLAYERCTL:-playerctl}"
CFG=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

case ${1:-} in
prev) "$PLAYERCTL" previous ;;
toggle) "$PLAYERCTL" play-pause ;;
next) "$PLAYERCTL" next ;;
*)
    echo "usage: qs-media-ctl prev|toggle|next" >&2
    exit 2
    ;;
esac
sleep 0.15 # let the player publish its new state
[ -n "${QS_NOREFRESH:-}" ] || eww --config "$CFG" update "qs_media=$("$CFG/scripts/qs-media")" >/dev/null 2>&1
