#!/usr/bin/env bash
# The media card's state as one JSON object (polled while the panel is open):
#   {"on":true,"status":"Playing","title":"..","artist":"..","art":"/path.jpg"}
# or {"on":false,...} with no player. Cover art comes from the player's artUrl:
# file:// as is, http(s) downloaded once into ~/.cache/rice/covers (curl, 4 s
# timeout, in the background so the poll never waits; the cover shows on the
# next poll).
# PLAYERCTL: tests.
PLAYERCTL="${PLAYERCTL:-playerctl}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/rice/covers"

# Fields are split by hand on the ASCII unit separator: read with a whitespace
# IFS would collapse an empty artUrl, and no title contains \x1f.
US=$'\x1f'
out=$("$PLAYERCTL" metadata --format "{{status}}$US{{artUrl}}$US{{title}}$US{{artist}}" 2>/dev/null)
if [ -z "$out" ]; then
    printf '%s\n' '{"on":false,"status":"","title":"","artist":"","art":""}'
    exit 0
fi
status=${out%%"$US"*}; out=${out#*"$US"}
url=${out%%"$US"*};    out=${out#*"$US"}
title=${out%%"$US"*};  artist=${out#*"$US"}

art=""
case $url in
file://*)
    art=${url#file://}
    [ -f "$art" ] || art=""
    ;;
http://* | https://*)
    key=$(printf '%s' "$url" | sha1sum | cut -c1-16)
    art="$CACHE/$key.img"
    if [ ! -s "$art" ]; then
        mkdir -p "$CACHE"
        # shellcheck disable=SC2016 # $1 $2 expand in the inner sh
        (setsid sh -c 'curl -fsL --max-time 4 -o "$1.part" "$2" && mv "$1.part" "$1" || rm -f "$1.part"' _ "$art" "$url" >/dev/null 2>&1 &)
        art=""
    fi
    ;;
esac

jq -cn --arg s "$status" --arg t "$title" --arg a "$artist" --arg i "$art" \
    '{on: true, status: $s, title: $t, artist: $a, art: $i}'
