;; Hover-triggered volume slider that lives pinned to the right screen edge.
;;
;; Two separate layer-shell windows, not one window with an internal
;; revealer around the hover hitbox -- a revealer inside a `halign`/`valign`
;; positioned box collapses that box (and its hover hitbox) to its content's
;; natural size, which is zero when the revealer is closed. Splitting into a
;; tiny always-on hotzone window (whose root widget is the hover-catching
;; eventbox, so it can't collapse) and a separate panel window that's
;; opened/closed on demand sidesteps that.
;;
;; The panel window has a FIXED geometry, so a revealer inside it is safe:
;; the window's eventbox keeps its full hitbox while the revealer inside
;; slides the gauge in from / out to the screen edge (`panel_open`, flipped
;; by scripts/show-panel.sh and scripts/maybe-close-panel.sh).
;;
;; The two windows sit edge-to-edge with no gap or overlap (panel's `x`
;; margin equals the hotzone's width) so a real, continuous mouse movement
;; crosses cleanly from one hitbox into the other.
;;
;; `eww open`/`eww close`/`eww update` need an explicit `--config` or they
;; can't find this daemon's socket -- ${EWW_CONFIG_DIR} is eww's own
;; built-in variable for this.
;;
;; Standalone daemon/config so it survives independently of whichever bar
;; the active theme uses -- see
;; ~/.config/theming/apply-theme.sh, which relaunches it after every theme
;; switch since that script's blanket `pkill -x eww` kills it too.

(deflisten vol_state :initial "{\"volume\": 0, \"muted\": false}"
  "scripts/volume-listen.sh")

(defvar panel_open false)

(defwindow volume-hotzone
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "volume-hotzone"
  :geometry (geometry :anchor "right center" :x "0px" :width "10px" :height "260px")
  (eventbox :onhover "scripts/show-panel.sh ${EWW_CONFIG_DIR}"
            :onhoverlost "scripts/maybe-close-panel.sh ${EWW_CONFIG_DIR}"
            :onscroll "scripts/scroll-volume.sh {}"
    (box :class "hotzone")))

(defwindow volume-panel
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "volume-panel"
  :geometry (geometry :anchor "right center" :x "10px" :width "90px" :height "260px")
  (eventbox :onhoverlost "scripts/maybe-close-panel.sh ${EWW_CONFIG_DIR}"
            :onscroll "scripts/scroll-volume.sh {}"
    (revealer :reveal panel_open
              :transition "slideleft"
              :duration "220ms"
              :halign "end"
      (volume-panel-content :volume {jq(vol_state, ".volume")} :muted {jq(vol_state, ".muted")}))))

(defwidget volume-panel-content [volume muted]
  ;; No traditional track-and-knob: the GtkScale itself IS the whole box
  ;; (trough stretched to fill it, knob hidden via CSS), so the fill level is
  ;; the only indicator, like a battery gauge. It's still a real GtkScale
  ;; underneath, so drag/click/scroll all keep working natively. Icon and
  ;; percentage float on top via `overlay`.
  ;;
  ;; `full` squares/rounds the fill's top corners (see eww.css); `muted`
  ;; dims the fill.
  (box :class "vol-card" :hexpand true :vexpand true
    (overlay
      (scale :class "vol-scale${volume >= 99 ? ' full' : ''}${muted ? ' muted' : ''}"
             :orientation "v"
             :flipped true
             :hexpand true
             :vexpand true
             :cursor "pointer"
             :value volume
             :min 0
             :max 100
             :onchange "scripts/set-volume.sh {}")
      (eventbox :class "vol-icon-hit" :cursor "pointer" :onclick "scripts/toggle-mute.sh"
                :halign "center" :valign "start"
        (label :class "vol-icon"
               :text {muted ? "󰖁" : (volume > 66 ? "󰕾" : (volume > 0 ? "󰖀" : "󰕿"))}))
      (label :class "vol-pct" :halign "center" :valign "end" :text "${volume}%"))))
