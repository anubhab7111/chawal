;; Hover-triggered volume slider that lives pinned to the right screen edge.
;; A thin strip is always there to catch the pointer; hovering it reveals a
;; vertical slider, and leaving the strip/slider (moving left, off the
;; widget) slides it back away. Purely hover-driven, no auto-hide timer.
;;
;; The window itself is a fixed-size surface sized for the *expanded* state
;; (eww's :geometry width/height pin the actual layer-shell surface size --
;; it does not auto-grow with the revealer). The hotzone strip and the
;; slider panel each get their own small eventbox instead of one eventbox
;; around the whole window, so hovering the empty transparent margin next
;; to them (still inside the fixed-size surface) does nothing -- only the
;; two real hit areas do.
;;
;; Standalone daemon/config so it survives independently of whichever bar
;; (waybar vs. the eww/arin dock) the active theme picks -- see
;; ~/.config/theming/apply-theme.sh, which relaunches it after every theme
;; switch since that script's blanket `pkill -x eww` kills it too.

(defvar reveal false)

(deflisten vol_state :initial "{\"volume\": 0, \"muted\": false}"
  "scripts/volume-listen.sh")

(defwindow volume-edge
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :geometry (geometry :anchor "right center" :width "110px" :height "260px")
  (volume-edge-widget))

(defwidget volume-edge-widget []
  (box :orientation "h" :space-evenly false :halign "end" :valign "center"
    (revealer :transition "slideleft" :duration "180ms" :reveal reveal
      (eventbox :onhoverlost "eww update reveal=false"
        (volume-panel :volume {jq(vol_state, ".volume")} :muted {jq(vol_state, ".muted")})))
    (eventbox :onhover "eww update reveal=true"
              :onscroll "scripts/scroll-volume.sh {}"
      (box :class "hotzone" :vexpand true))))

(defwidget volume-panel [volume muted]
  (box :class "volume-panel" :orientation "v" :space-evenly false :valign "center" :halign "center"
    (eventbox :cursor "pointer" :onclick "scripts/toggle-mute.sh"
      (label :class "vol-icon"
             :text {muted ? "󰖁" : (volume > 66 ? "󰕾" : (volume > 0 ? "󰖀" : "󰕿"))}))
    (scale :class "vol-scale"
           :orientation "v"
           :value volume
           :min 0
           :max 100
           :onchange "scripts/set-volume.sh {}")
    (label :class "vol-pct" :text "${volume}%")))
