;; Hover-triggered brightness slider pinned to the left screen edge -- the
;; mirror image of ../volume-edge (see that file for why it's split into a
;; tiny always-on hotzone window plus an on-demand panel window, how the
;; revealer slide works, and why `eww open`/`close`/`update` need an
;; explicit --config).
;;
;; Standalone daemon/config so it survives independently of whichever bar
;; the active theme picks -- ~/.config/theming/apply-theme.sh relaunches it
;; after every theme switch.

(deflisten bright_state :initial "{\"brightness\": 100}"
  "scripts/brightness-listen.sh")

(defvar panel_open false)

(defwindow brightness-hotzone
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "brightness-hotzone"
  :geometry (geometry :anchor "left center" :x "0px" :width "10px" :height "260px")
  (eventbox :onhover "scripts/show-panel.sh ${EWW_CONFIG_DIR}"
            :onhoverlost "scripts/maybe-close-panel.sh ${EWW_CONFIG_DIR}"
            :onscroll "scripts/scroll-brightness.sh {}"
    (box :class "hotzone")))

(defwindow brightness-panel
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "brightness-panel"
  :geometry (geometry :anchor "left center" :x "10px" :width "90px" :height "260px")
  (eventbox :onhoverlost "scripts/maybe-close-panel.sh ${EWW_CONFIG_DIR}"
            :onscroll "scripts/scroll-brightness.sh {}"
    (revealer :reveal panel_open
              :transition "slideright"
              :duration "220ms"
              :halign "start"
      (brightness-panel-content :brightness {jq(bright_state, ".brightness")}))))

(defwidget brightness-panel-content [brightness]
  ;; Same gauge-style GtkScale as the volume panel: the fill level is the
  ;; only indicator, icon and percentage float on top via `overlay`.
  ;; `full` rounds the fill's top corners at 100% (see eww.css).
  (box :class "brightness-panel" :hexpand true :vexpand true
    (overlay
      (scale :class "bri-scale${brightness >= 99 ? ' full' : ''}"
             :orientation "v"
             :flipped true
             :hexpand true
             :vexpand true
             :cursor "pointer"
             :value brightness
             :min 0
             :max 100
             :onchange "scripts/set-brightness.sh {}")
      (label :class "bri-icon" :halign "center" :valign "start"
             :text {brightness > 66 ? "󰃠" : (brightness > 33 ? "󰃟" : "󰃞")})
      (label :class "bri-pct" :halign "center" :valign "end" :text "${brightness}%"))))
