#!/usr/bin/env bash
# rice-hub: the rofi control hub. One window, Tab / Shift+Tab flip between tabs.
#
#   rice-hub [TAB]    TAB is drun (default), toggles, windows, clip, wall or power
#                     ("window" still works as an alias for windows)
#
# Every tab but Apps is one of the rice-* scripts running as a rofi mode (they
# detect ROFI_RETV and answer rofi instead of opening their own menu). Their
# tab names are the prompt each prints itself (\0prompt "<glyph>  Name");
# -display-* only names the builtin Apps tab (config.rasi).
#
# Hotkeys: Alt+1..4 are the per-row actions of the current tab, whatever it
# calls them (windows: close / float / pin / bring here; clip: delete / wipe
# all). Ctrl+Delete and Ctrl+Shift+Delete stay as the clip aliases;
# Control+Alt+d takes over word-delete.

set -euo pipefail

BIN="$HOME/.config/rice/bin"
tab=${1:-drun}
[ "$tab" = window ] && tab=windows

exec rofi -show "$tab" \
    -modes "drun,toggles:$BIN/rice-toggles,windows:$BIN/rice-windows,clip:$BIN/rice-clip,wall:$BIN/rice-wall,power:$BIN/rice-power" \
    -kb-remove-word-forward "Control+Alt+d" \
    -kb-custom-1 "Alt+1,Control+Delete" \
    -kb-custom-2 "Alt+2,Control+Shift+Delete" \
    -kb-custom-3 "Alt+3" \
    -kb-custom-4 "Alt+4" \
    -theme-str 'window { width: 900px; } element-icon { size: 32px; }'
