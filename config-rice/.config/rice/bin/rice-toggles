#!/usr/bin/env bash
# rice-toggles: quick toggles as a rofi mode (the hub's Toggles tab).
#
#   rice-toggles       open rofi on the Toggles tab alone
#
# One row per switch: Wi-Fi, Bluetooth, Night light, Do not disturb, Caffeine,
# Game mode, Mute speakers, Mute microphone. A row that is on is highlighted
# (rofi "active"). Enter flips it and redraws the list in place with the
# selection kept, so several switches can be flipped in a row.
# Rofi calls this script back as its "toggles" mode (ROFI_RETV 0 open, 1 pick);
# the pick arrives as ROFI_INFO. RICE_BIN overrides where the rice-* scripts are.

set -euo pipefail

BIN="${RICE_BIN:-$HOME/.config/rice/bin}"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rice"

if [ -z "${ROFI_RETV:-}" ]; then
    exec rofi -show toggles -modes "toggles:$0" \
        -theme-str 'window { width: 460px; } listview { lines: 8; } mainbox { children: [ inputbar, message, listview ]; }'
fi

# Hub launch: rice-hub already ran this tab (in parallel with the others) and
# left its output in $RICE_PRE; rofi would otherwise run every tab one after
# another before the window can appear. Falls through to a normal run if the
# output never shows up.
if [ "${ROFI_RETV:-}" = 0 ] && [ -n "${RICE_PRE:-}" ]; then
    for ((i = 0; i < 600; i++)); do
        [ -f "$RICE_PRE/toggles.out" ] && exec cat "$RICE_PRE/toggles.out"
        sleep 0.005
    done
fi

# id|glyph|label, in display order. Glyphs are Material Design escapes.
ROWS=(
    $'wifi|\U000F05A9|Wi-Fi'
    $'bluetooth|\U000F00AF|Bluetooth'
    $'night|\U000F0594|Night light'
    $'dnd|\U000F009B|Do not disturb'
    $'caffeine|\U000F0176|Caffeine'
    $'game|\U000F0297|Game mode'
    $'mute|\U000F0581|Mute speakers'
    $'mic|\U000F036D|Mute microphone'
)

is_on() { # id: succeed when the switch is on
    case $1 in
    wifi) [ "$(nmcli radio wifi 2>/dev/null)" = enabled ] ;;
    bluetooth) timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' ;;
    night) [ -f "$RUN/nightlight" ] ;;
    dnd) [ "$("$BIN/rice-dnd" status 2>/dev/null)" = on ] ;;
    caffeine) "$BIN/rice-caffeine" status 2>/dev/null | grep -q '"alt":"on"' ;;
    game) [ -f "$RUN/gamemode" ] ;;
    mute) [ "$(pamixer --get-mute 2>/dev/null)" = true ] ;;
    mic) [ "$(pamixer --default-source --get-mute 2>/dev/null)" = true ] ;;
    esac
}

flip() { # id: toggle the switch; output off rofi's pipe
    {
        case $1 in
        wifi) if is_on wifi; then nmcli radio wifi off; else nmcli radio wifi on; fi ;;
        bluetooth)
            if is_on bluetooth; then timeout 5 bluetoothctl power off; else
                rfkill unblock bluetooth 2>/dev/null || true
                timeout 5 bluetoothctl power on
            fi
            ;;
        night) "$BIN/rice-nightlight" toggle ;;
        dnd) "$BIN/rice-dnd" toggle ;;
        caffeine) "$BIN/rice-caffeine" toggle ;;
        game) "$BIN/rice-gamemode" toggle ;;
        mute) pamixer --toggle-mute ;;
        mic) pamixer --default-source --toggle-mute ;;
        esac
    } >/dev/null 2>&1 || true
}

list() {
    local row id glyph label tmp
    # the eight state checks are independent commands: run them side by side
    # (a file per switch that is on) instead of one after another
    tmp=$(mktemp -d)
    for row in "${ROWS[@]}"; do
        id=${row%%|*}
        (is_on "$id" && : >"$tmp/$id") &
    done
    wait
    printf '\0prompt\x1f%s\n' $'\U000F0521  Toggles'
    printf '\0no-custom\x1ftrue\n\0keep-selection\x1ftrue\n'
    printf '\0message\x1f%s\n' "Enter flips a switch    Tab next tab"
    for row in "${ROWS[@]}"; do
        IFS='|' read -r id glyph label <<<"$row"
        if [ -e "$tmp/$id" ]; then
            printf '%s  %s  ·  on\0info\x1f%s\x1factive\x1ftrue\n' "$glyph" "$label" "$id"
        else
            printf '%s  %s  ·  off\0info\x1f%s\n' "$glyph" "$label" "$id"
        fi
    done
    rm -rf "$tmp"
}

[ "$ROFI_RETV" = 1 ] && [ -n "${ROFI_INFO:-}" ] && flip "$ROFI_INFO"
list
exit 0
