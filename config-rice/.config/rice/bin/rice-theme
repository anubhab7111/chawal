#!/usr/bin/env bash
# rice-theme: switch the desktop theme without writing into the dotfiles repo.
#
#   rice-theme bootstrap      create the state dir and slot links (idempotent)
#   rice-theme apply [NAME]   switch to NAME (default: the saved theme), reload apps
#   rice-theme toggle         switch between mocha and latte
#   rice-theme get            print the saved theme
#   rice-theme list           print the available themes
#
# The active theme lives in ~/.local/state/rice (theme = its name,
# current -> its directory). Apps reach it through gitignored "slot" links
# inside the stowed packages, chiefly ~/.config/theming/current, so nothing
# tracked in git is ever edited.

set -euo pipefail

THEMES="$HOME/.config/theming/themes"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/rice"
CURRENT="$HOME/.config/theming/current"
DEFAULT=mocha

die() { echo "rice-theme: $*" >&2; exit 1; }

get() {
    local name=""
    [ -f "$STATE/theme" ] && name=$(tr -d '[:space:]' < "$STATE/theme")
    [ "$name" = catppuccin ] && name=mocha # the pre-P10 name
    if [ -z "$name" ] || [ ! -d "$THEMES/$name" ]; then
        name=$DEFAULT
    fi
    printf '%s\n' "$name"
}

# slot TARGET LINK: point LINK at TARGET, but never replace a real file.
slot() {
    local target=$1 link=$2
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        echo "rice-theme: $link is a real file, leaving it alone" >&2
        return 0
    fi
    mkdir -p "$(dirname "$link")"
    ln -sfn "$target" "$link"
}

# gtk_theme_dir: print the directory of the active theme's GTK theme (named in
# its gtk-theme file); fail when it isn't installed.
gtk_theme_dir() {
    local name d
    [ -f "$CURRENT/gtk-theme" ] || return 1
    name=$(tr -d '[:space:]' < "$CURRENT/gtk-theme")
    for d in "$HOME/.themes/$name" "/usr/share/themes/$name"; do
        [ -d "$d" ] && { printf '%s\n' "$d"; return 0; }
    done
    return 1
}

# kde_colors: KDE apps (Dolphin, Okular, ...) ignore the Qt palette and read
# kdeglobals, so make the active theme visible there:
#   - the theme's scheme file (kde-colors.colors, named "Rice") is linked into
#     ~/.local/share/color-schemes and selected by [General] and [UiSettings]
#     ColorScheme=Rice (apps pick it up at start);
#   - its [Colors:*] sections replace the ones in kdeglobals (the values
#     running apps and KColorScheme read);
#   - [KDE] widgetStyle=kvantum, since a named style (Breeze by default) wins
#     over the Qt style qt6ct sets.
# Everything else in kdeglobals is left alone; the first version of the file
# is kept in the state dir as kdeglobals.orig.
kde_colors() {
    local src="$CURRENT/kde-colors.colors" kg="$HOME/.config/kdeglobals" new
    [ -f "$src" ] || return 0
    slot "$src" "$HOME/.local/share/color-schemes/Rice.colors"
    [ -f "$STATE/kdeglobals.orig" ] || { [ -f "$kg" ] && cp "$kg" "$STATE/kdeglobals.orig"; } || true
    new=$(
        {
            [ -f "$kg" ] && awk '
                /^\[/ { sect = $0; skip = (sect ~ /^\[Colors:/ || sect == "[UiSettings]") }
                skip { next }
                sect == "[General]" && /^ColorScheme(Hash)?=/ { next }
                sect == "[KDE]" && /^widgetStyle=/ { next }
                { print }
                $0 == "[General]" { print "ColorScheme=Rice" }
                $0 == "[KDE]" { print "widgetStyle=kvantum" }
            ' "$kg"
            printf '\n'
            awk '/^\[/ { p = ($0 ~ /^\[Colors:/) } p' "$src"
            printf '[UiSettings]\nColorScheme=Rice\n'
        }
    )
    # a kdeglobals without these sections still needs the keys
    case $new in *$'\n[General]\n'* | '[General]'*) ;; *) new+=$'\n\n[General]\nColorScheme=Rice' ;; esac
    case $new in *$'\n[KDE]\n'* | '[KDE]'*) ;; *) new+=$'\n\n[KDE]\nwidgetStyle=kvantum' ;; esac
    if [ "$(cat "$kg" 2>/dev/null)" != "$new" ]; then
        printf '%s\n' "$new" > "$kg"
    fi
}

bootstrap() {
    local name
    name=$(get)
    mkdir -p "$STATE"
    printf '%s\n' "$name" > "$STATE/theme"
    ln -sfn "$THEMES/$name" "$STATE/current"

    slot "$STATE/current" "$CURRENT"
    slot "$CURRENT/waybar-colors.css" "$HOME/.config/waybar/colors.css"
    slot "$CURRENT/waybar-colors.css" "$HOME/.config/swaync/colors.css" # same @define-color palette
    slot "$CURRENT/cava.theme" "$HOME/.config/cava/themes/rice"
    slot "$CURRENT/btop.theme" "$HOME/.config/btop/themes/rice.theme"
    slot "$CURRENT/rofi-colors.rasi" "$HOME/.config/rofi/themes/colors.rasi"
    slot "$CURRENT/tmux-colors.conf" "$HOME/.config/tmux/colors.conf"

    # Qt6 (qt6ct -> Kvantum): Kvantum reads its theme name from a plain file
    # it watches, so write that file in place (a link swap would go unnoticed).
    if [ -f "$CURRENT/kvantum-theme" ]; then
        local kv="$HOME/.config/Kvantum/kvantum.kvconfig" want
        want=$(printf '[General]\ntheme=%s\n' "$(tr -d '[:space:]' < "$CURRENT/kvantum-theme")")
        if [ "$(cat "$kv" 2>/dev/null)" != "$want" ]; then
            mkdir -p "$(dirname "$kv")"
            printf '%s\n' "$want" > "$kv"
        fi
    fi

    slot "$CURRENT/qt6ct-colors.conf" "$HOME/.config/qt6ct/colors/rice.conf"
    kde_colors

    # GTK4 reads the theme's css from ~/.config/gtk-4.0. Point it at the
    # active GTK theme, but only when that theme is installed (Latte's is
    # an AUR package), so a missing package never breaks the links.
    local gtk
    if gtk=$(gtk_theme_dir); then
        slot "$gtk/gtk-4.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
        slot "$gtk/gtk-4.0/gtk-dark.css" "$HOME/.config/gtk-4.0/gtk-dark.css"
        slot "$gtk/gtk-4.0/assets" "$HOME/.config/gtk-4.0/assets"
    fi

    # alacritty watches the inode of the file it imports, so a retargeted
    # symlink goes unnoticed: copy the colours over the same file instead.
    if ! cmp -s "$CURRENT/alacritty-colors.toml" "$STATE/alacritty-colors.toml"; then
        cp "$CURRENT/alacritty-colors.toml" "$STATE/alacritty-colors.toml"
    fi
}

# Wallpaper per output: the theme's wallpaper.conf ("<output>:<path>", or
# "*:<path>" for all), overridden by picks rice-wall saved for this theme.
reload_wallpaper() {
    local conf="$CURRENT/wallpaper.conf" picks output path f
    local -A wall=()
    picks="$STATE/wallpaper/$(get)"
    if [ -f "$conf" ]; then
        while IFS=: read -r output path; do
            [ -z "$output" ] && continue
            case "$output" in \#*) continue ;; esac
            wall[$output]=$path
        done < "$conf"
    fi
    for f in "$picks"/*; do
        [ -f "$f" ] && wall[${f##*/}]=$(head -n1 "$f")
    done
    # "*" first, so per-output entries land on top of it
    if [ -n "${wall["*"]:-}" ]; then
        if [ -f "${wall["*"]}" ]; then
            awww img "${wall["*"]}" >/dev/null 2>&1 || true
        else
            echo "rice-theme: wallpaper not found, skipping: ${wall["*"]}" >&2
        fi
        unset 'wall[*]'
    fi
    for output in "${!wall[@]}"; do
        path=${wall[$output]}
        if [ ! -f "$path" ]; then
            echo "rice-theme: wallpaper not found, skipping: $path" >&2
            continue
        fi
        awww img "$path" -o "$output" >/dev/null 2>&1 &
    done
    wait
}

reload_hyprland() {
    # reload re-runs the Lua config, which reads the palette through
    # theming/current. It also clears screen_shader, so set that after.
    hyprctl reload >/dev/null 2>&1 || true
    local shader=""
    [ -f "$CURRENT/screen.frag" ] && shader=$(readlink -f "$CURRENT/screen.frag")
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null 2>&1 || true
}

reload_obsidian() {
    # Copy (not link) the palette snippet into every vault, so Obsidian's
    # file watcher restyles open windows. Vaults come from obsidian.json.
    local palette="$CURRENT/obsidian-colors.css" json="$HOME/.config/obsidian/obsidian.json" vault
    [ -f "$palette" ] && [ -f "$json" ] || return 0
    python3 - "$json" <<'PYEOF' | while IFS= read -r vault; do
import json, sys
with open(sys.argv[1]) as f:
    for v in json.load(f).get("vaults", {}).values():
        print(v.get("path", ""))
PYEOF
        [ -d "$vault/.obsidian" ] || continue
        mkdir -p "$vault/.obsidian/snippets"
        cp "$palette" "$vault/.obsidian/snippets/rice-palette.css" || true
    done
}

reload_apps() {
    reload_wallpaper
    reload_hyprland

    if [ -f "$CURRENT/gtk-icon-theme" ]; then
        gsettings set org.gnome.desktop.interface icon-theme \
            "$(tr -d '[:space:]' < "$CURRENT/gtk-icon-theme")" >/dev/null 2>&1 || true
    fi

    # Light/dark for libadwaita, Firefox and Brave, and the GTK theme for the
    # rest (settings.ini no longer names one, so gsettings decides).
    if [ -f "$CURRENT/color-scheme" ]; then
        gsettings set org.gnome.desktop.interface color-scheme \
            "$(tr -d '[:space:]' < "$CURRENT/color-scheme")" >/dev/null 2>&1 || true
    fi
    local gtk
    if gtk=$(gtk_theme_dir); then
        gsettings set org.gnome.desktop.interface gtk-theme "${gtk##*/}" >/dev/null 2>&1 || true
    fi

    pkill -USR2 -x waybar >/dev/null 2>&1 || true # full reload: config + css
    pkill -USR2 -x cava >/dev/null 2>&1 || true   # colours only
    swaync-client -rs -sw >/dev/null 2>&1 || true # reload the stylesheet (colours)

    # the one eww daemon (edge gauges); a reload re-reads the stylesheet
    if eww ping >/dev/null 2>&1; then
        eww reload >/dev/null 2>&1 || true
    fi

    reload_obsidian

    # neovim: repaint running instances (lua/rice). timeout: an instance
    # stuck at a prompt must not hang the switch.
    local sock
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
        [ -S "$sock" ] || continue
        timeout 2 nvim --server "$sock" --remote-expr 'luaeval("require(\"rice\").reload_async()")' >/dev/null 2>&1 || true
    done
    # tmux: re-read the config (it bakes the colours in at load time)
    if tmux has-session >/dev/null 2>&1; then
        tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
    fi
    # btop reads its theme at start; alacritty follows the copied file.
}

apply() {
    local name=${1:-$(get)}
    [ -d "$THEMES/$name" ] || die "no such theme: $name (rice-theme list)"
    mkdir -p "$STATE"
    printf '%s\n' "$name" > "$STATE/theme"
    bootstrap
    reload_apps
    echo "theme: $name"
}

case ${1:-} in
bootstrap) bootstrap ;;
apply) apply "${2:-}" ;;
toggle)
    case $(get) in
    mocha) next=latte ;;
    *) next=mocha ;;
    esac
    [ -d "$THEMES/$next" ] || die "no $next theme yet"
    apply "$next"
    ;;
get) get ;;
list) ls -1 "$THEMES" ;;
*)
    sed -n '3,9s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
