#!/usr/bin/env bash
# rice-sync KEY: tell the bar a rice toggle changed, so it refreshes now
# instead of on its next poll. Every rice-* toggle ends with this.
#
#   gamemode   -> Waybar custom/gamemode (SIGRTMIN+10)
#   recording  -> Waybar custom/recording (SIGRTMIN+9)

case ${1:-} in
gamemode) pkill -RTMIN+10 -x waybar 2>/dev/null ;;
recording) pkill -RTMIN+9 -x waybar 2>/dev/null ;;
*)
    echo "rice-sync: unknown key: ${1:-}" >&2
    exit 2
    ;;
esac
exit 0
