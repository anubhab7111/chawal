#!/usr/bin/env bash
# rice-toggle: the quick toggles behind the eww quick-settings panel (qs).
#
#   rice-toggle json        all tiles as a JSON array, for the panel
#   rice-toggle rows        the same, as [[tile, tile], [tile, tile], ...] (two per row)
#   rice-toggle flip ID     flip one switch (ids below)
#   rice-toggle state ID    print on or off
#
# Tiles: wifi, bluetooth, dnd, night, caffeine, game, power, theme.
# power is the TLP profile (a click cycles power-saver / balanced /
# performance; on = not balanced; disabled when tlp-pd doesn't answer). theme
# is on while Latte is the active theme. Each tile is
#   {"id","icon","label","sub","on","enabled"}
# where sub is the small line under the label (the network name for Wi-Fi;
# `Until HH:MM` while a Do-not-disturb or Caffeine timer runs).
#
# Backends: nmcli, bluetoothctl, rice-dnd, rice-nightlight, rice-caffeine, rice-power-profile and
# rice-gamemode. RICE_BIN overrides where those live (tests).

set -u

BIN="${RICE_BIN:-$HOME/.config/rice/bin}"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rice"

# id|icon|label (Material Design glyphs), in display order
TILES=(
    $'wifi|\U000F05A9|Wi-Fi'
    $'bluetooth|\U000F00AF|Bluetooth'
    $'dnd|\U000F009B|Do not disturb'
    $'night|\U000F0594|Night light'
    $'caffeine|\U000F0176|Caffeine'
    $'game|\U000F0297|Game mode'
    $'power|\U000F140B|Power profile'
    $'theme|\U000F0B2F|Theme'
)

# Wi-Fi and Bluetooth are read and written straight over D-Bus (2-8 ms), not
# through nmcli (25-30 ms) and bluetoothctl (a process start each); the old
# commands stay as the fallback when the service does not answer.
sysbool() { # service path interface property: 0 = true, 1 = false, 2 = no answer
    local out
    out=$(timeout 2 busctl --system get-property "$@" 2>/dev/null) || return 2
    case $out in
    "b true") return 0 ;;
    "b false") return 1 ;;
    *) return 2 ;;
    esac
}
sysset() { # service path interface property true|false
    timeout 3 busctl --system set-property "$1" "$2" "$3" "$4" b "$5" >/dev/null 2>&1
}
NM=(org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager WirelessEnabled)
BT=(org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered)

wifi_ssid() { # the network we are on (iw reads it from the driver in 5 ms; nmcli needs 22 ms)
    local ifc s=""
    if command -v iw >/dev/null 2>&1; then
        ifc=$(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2; exit }')
        [ -n "$ifc" ] && s=$(iw dev "$ifc" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p')
    fi
    [ -n "$s" ] || s=$(nmcli -t -f ACTIVE,SSID device wifi list --rescan no 2>/dev/null | awk -F: '$1 == "yes" { print $2; exit }')
    printf '%s' "$s"
}

on() { # id: succeed when the switch is on
    local rc
    case $1 in
    wifi)
        sysbool "${NM[@]}"; rc=$?
        [ $rc -lt 2 ] && return $rc
        [ "$(nmcli radio wifi 2>/dev/null)" = enabled ]
        ;;
    bluetooth)
        sysbool "${BT[@]}"; rc=$?
        [ $rc -lt 2 ] && return $rc
        timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'
        ;;
    dnd) [ "$("$BIN/rice-dnd" status 2>/dev/null)" = on ] ;;
    night) [ -f "$RUN/nightlight" ] ;;
    caffeine) "$BIN/rice-caffeine" status 2>/dev/null | grep -q '"alt":"on"' ;;
    game) [ -f "$RUN/gamemode" ] ;;
    theme) [ "$("$BIN/rice-theme" get 2>/dev/null)" = latte ] ;;
    power) # on = a non-default profile (power-saver or performance)
        local p
        p=$("$BIN/rice-power-profile" get 2>/dev/null) && [ "$p" != balanced ]
        ;;
    *) return 1 ;;
    esac
}

sub() { # id on?: the small line under the label
    local t
    case $1 in
    wifi)
        if [ "$2" = 1 ]; then
            local s
            s=$(wifi_ssid)
            printf '%s' "${s:-On}"
        else printf Off; fi
        ;;
    dnd)
        if [ "$2" = 1 ]; then
            t=$("$BIN/rice-dnd" until 2>/dev/null)
            if [ -n "$t" ]; then printf 'Until %s' "$t"; else printf On; fi
        else printf Off; fi
        ;;
    caffeine)
        if [ "$2" = 1 ]; then
            t=$("$BIN/rice-caffeine" until 2>/dev/null)
            if [ -n "$t" ]; then printf 'Until %s' "$t"; else printf On; fi
        else printf Off; fi
        ;;
    power) "$BIN/rice-power-profile" get 2>/dev/null || printf 'Unavailable' ;;
    theme) if [ "$2" = 1 ]; then printf Latte; else printf Mocha; fi ;;
    *) [ "$2" = 1 ] && printf On || printf Off ;;
    esac
}

# one line per tile: id TAB icon TAB label TAB on TAB enabled TAB sub
lines() {
    local dir row id icon label
    dir=$(mktemp -d)
    # the state checks are independent commands: run them side by side
    for row in "${TILES[@]}"; do
        id=${row%%|*}
        (
            o=0
            on "$id" && o=1
            printf '%s\t%s' "$o" "$(sub "$id" "$o")" >"$dir/$id"
        ) &
    done
    wait
    for row in "${TILES[@]}"; do
        IFS='|' read -r id icon label <<<"$row"
        local en=1 o s
        IFS=$'\t' read -r o s <"$dir/$id"
        # power profile: disabled (and off) while tlp-pd doesn't answer
        case $id in power) [ "$s" = Unavailable ] && en=0 ;; esac
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$icon" "$label" "$o" "$en" "$s"
    done
    rm -rf "$dir"
}

tiles='split("\n")[:-1] | map(split("\t"))
        | map({id: .[0], icon: .[1], label: .[2], on: (.[3] == "1"), enabled: (.[4] == "1"), sub: .[5]})'

json() { lines | jq -R -s -c "$tiles"; }

# two tiles per row, in the one jq call (it used to be two, one per pipe stage)
rows() { lines | jq -R -s -c "$tiles"' | . as $t | [range(0; length; 2) | $t[.:.+2]]'; }

flip() {
    local v
    {
        case $1 in
        wifi)
            if on wifi; then v=false; else v=true; fi
            sysset "${NM[@]}" "$v" || nmcli radio wifi "$([ "$v" = true ] && echo on || echo off)"
            ;;
        bluetooth)
            if on bluetooth; then v=false; else
                v=true
                rfkill unblock bluetooth 2>/dev/null || true
            fi
            sysset "${BT[@]}" "$v" || timeout 5 bluetoothctl power "$([ "$v" = true ] && echo on || echo off)"
            ;;
        dnd) "$BIN/rice-dnd" toggle ;;
        night) "$BIN/rice-nightlight" toggle ;;
        caffeine) "$BIN/rice-caffeine" toggle ;;
        game) "$BIN/rice-gamemode" toggle ;;
        theme) "$BIN/rice-theme" toggle ;;
        power) "$BIN/rice-power-profile" cycle ;;
        esac
    } >/dev/null 2>&1 || true
}

case ${1:-} in
json) json ;;
rows) rows ;;
flip) flip "${2:?usage: rice-toggle flip ID}" ;;
state) if on "${2:?usage: rice-toggle state ID}"; then echo on; else echo off; fi ;;
*)
    sed -n '3,8s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
